---
import CardInfo from "../layout/cards/CardInfo.astro";
import ProfilePicture from "../layout/profile/ProfilePicture.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";

interface Props {
  year?: number;
  pinned?: boolean;
  load?: "lazy" | "eager";
}
const { year, pinned, load = "eager" } = Astro.props as Props;
const t = useTranslations(Astro.currentLocale);
---

<article class="px-4 py-2 border-b border-line">
  {
    pinned && (
      <div class="px-6 mb-1 text-muted text-xs font-medium items-center gap-1 flex">
        <Icon name="pin" class="size-4" aria-hidden="true" />
        <span>{t("card.pinned")}</span>
      </div>
    )
  }
  <div class="flex items-start gap-2">
    <div>
      <ProfilePicture load={load} alt="" clazz="w-12 border" />
    </div>
    <div>
      <CardInfo year={year} />
      <div class="text-sm font-medium text-text">
        <slot />
      </div>
    </div>
  </div>
</article>
