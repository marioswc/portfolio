---
// import all the components for the tabs
import Overview from "@components/layout/sections/Overview.astro";
import Projects from "@components/layout/sections/Projects.astro";
import Journey from "@components/layout/sections/Journey.astro";
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);

const tabs = [
  { id: "overview", label: t("tabs.overview") },
  { id: "projects", label: t("tabs.projects") },
  { id: "journey", label: t("tabs.journey") },
];
---

<!-- Tab Menu -->
<div
  role="tablist"
  aria-label={t("tabs.ariaLabel")}
  class="flex items-center md:justify-center justify-start mt-5 overflow-auto scrollbar-none border-b border-line"
  id="tab-menu"
>
  {
    tabs.map((tab, index) => (
      <button
        id={tab.id}
        type="button"
        role="tab"
        aria-controls={`panel-${tab.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        class="capitalize cursor-pointer text-muted flex-1 border-b-2 border-transparent text-sm font-medium
        p-2 hover:bg-primary-hover hover:text-text hover:border-line transition-colors duration-300 ease-in-out aria-selected:font-semibold aria-selected:bg-primary-hover aria-selected:text-text group aria-selected:border-b-2 aria-selected:border-line-selected"
      >
        {tab.label}
      </button>
    ))
  }
</div>
<div>
  <div id="panel-overview" role="tabpanel" aria-labelledby="overview">
    <h2 class="sr-only capitalize">{t("tabs.overview")}</h2>
    <Overview />
  </div>
  <div id="panel-projects" class="hidden" role="tabpanel" aria-labelledby="projects">
    <h2 class="sr-only capitalize">{t("tabs.projects")}</h2>
    <Projects />
  </div>
  <div id="panel-journey" class="hidden" role="tabpanel" aria-labelledby="journey">
    <h2 class="sr-only capitalize">{t("tabs.journey")}</h2>
    <Journey />
  </div>
</div>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>("#tab-menu button");
  const panels = document.querySelectorAll<HTMLElement>("[role=tabpanel]");
  const validTabs = new Set(Array.from(btns, (btn) => btn.id));

  const activateTab = (tabId: string, updateHash = false) => {
    const targetId = validTabs.has(tabId) ? tabId : "overview";

    btns.forEach((btn) => {
      btn.setAttribute("aria-selected", String(btn.id === targetId));
    });

    panels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.id !== `panel-${targetId}`);
    });

    if (updateHash) {
      const nextUrl =
        targetId === "overview"
          ? `${window.location.pathname}${window.location.search}`
          : `#${targetId}`;
      history.replaceState(null, "", nextUrl);
    }
  };

  const initialHash = window.location.hash.slice(1);
  if (initialHash && validTabs.has(initialHash)) {
    activateTab(initialHash, false);
  }

  btns.forEach((btnSelected) => {
    btnSelected.addEventListener("click", () => {
      activateTab(btnSelected.id, true);
    });
  });

  window.addEventListener("hashchange", () => {
    const hashTab = window.location.hash.slice(1);
    activateTab(hashTab || "overview", false);
  });
</script>
