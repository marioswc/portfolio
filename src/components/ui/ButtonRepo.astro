---
import type { ImageMetadata } from "astro";
import Modal from "./Modal.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";

interface Props {
  code_url?: string;
  demo_url?: string;
  id?: string;
  title?: string;
  img?: ImageMetadata;
  desc?: string;
  features?: string[];
  stack?: string[];
}
const { code_url, demo_url, id, title, img, desc, stack, features } =
  Astro.props as Props;
const t = useTranslations(Astro.currentLocale);
---

<div class="flex items-center justify-around text-sm text-muted mt-2 max-w-md">
  <Modal
    id=`project-${id}`
    title={t("projects.details")}
    ariaLabel={title ? `${t("projects.viewDetailsFor")} ${title}` : t("projects.viewDetails")}
    dialClass="max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-3xl"
    btnClass="flex items-center gap-1.5 p-2 rounded-full hover:bg-primary-hover hover:text-primary"
  >
    <Fragment slot="content">
      <article class="text-left max-h-[75dvh] overflow-y-auto pr-1">
        {
          img && (
            <figure class="border overflow-hidden rounded-lg shadow-sm border-line w-full bg-white">
              <Image
                src={img}
                alt={title ? `${t("projects.previewAlt")} ${title}` : t("projects.projectPreview")}
                width={896}
                widths={[448, 896]}
                sizes="(max-width: 640px) 100vw, 448px"
                class="object-contain w-full h-auto max-h-64 sm:max-h-80 md:max-h-96 mx-auto block"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                draggable="false"
              />
            </figure>
          )
        }
        <h3 class="text-text text-lg font-semibold mt-3">{title}</h3>
        <p class="text-muted text-sm">{desc}</p>
        <div class="flex items-center gap-4 my-2 text-sm">
          <a
            href={demo_url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title ? `${t("projects.viewDemoFor")} ${title}` : t("projects.viewDemo")}
            class="flex items-center gap-1 p-2 rounded-full bg-bg-secondary text-text-secondary hover:bg-secondary-hover transition-all duration-300 ease-linear"
          >
            <Icon name="square-out" class="size-4" aria-hidden="true" />
            {t("projects.demo")}
          </a>
          <a
            href={code_url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title ? `${t("projects.viewCodeFor")} ${title}` : t("projects.viewCode")}
            class="flex items-center gap-1 p-2 rounded-full bg-bg border border-line text-text hover:bg-primary-hover transition-all duration-300 ease-linear"
          >
            <Icon name="code" class="size-4" aria-hidden="true" />
            {t("projects.code")}
          </a>
        </div>
        <div class="mt-2">
          <p class="text-text font-semibold">{t("projects.features")}</p>
          <ul class="text-muted mt-1">
            {
              features?.map((feat) => (
                <li class="flex items-center gap-1">
                  <Icon name="check" class="size-4 text-primary" aria-hidden="true" />
                  {feat}
                </li>
              ))
            }
          </ul>
          <p class="mt-2 text-text font-semibold">{t("projects.stack")}</p>
          <ul class="flex flex-wrap gap-2 items-start text-sm text-muted mt-1">
            {
              stack?.map((tag) => (
                <li class="border border-line px-2 rounded-md">{tag}</li>
              ))
            }
          </ul>
        </div>
      </article>
    </Fragment>

    <Fragment slot="btnShowModal">
      <Icon name="info" class="size-4" aria-hidden="true" />
      <span class="text-sm">{t("projects.details")}</span>
    </Fragment>
  </Modal>

  <a
    href={code_url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={title ? `${t("projects.viewCodeFor")} ${title}` : t("projects.viewCode")}
    class="flex items-center gap-1.5 p-2 rounded-full hover:bg-primary-hover hover:text-primary transition-all duration-300 ease-linear"
  >
    <Icon name="code" class="size-5" aria-hidden="true" />
    {t("projects.code")}
  </a>
  <a
    href={demo_url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={title ? `${t("projects.viewDemoFor")} ${title}` : t("projects.viewDemo")}
    class="flex items-center gap-1.5 p-2 rounded-full hover:bg-primary-hover hover:text-primary transition-all duration-300 ease-linear"
  >
    <Icon name="square-out" class="size-4" aria-hidden="true" />
    {t("projects.demo")}
  </a>
</div>
