---
import { Icon } from "astro-icon/components";
---

<button
  id="btn-config"
  class="w-full flex items-center justify-center text-sm gap-2 font-bold cursor-pointer p-2 border rounded-full bg-bg-secondary text-text-secondary hover:bg-secondary-hover transition-colors duration-300 ease-linear">
  <Icon name="settings" class="size-4" />
  Settings
</button>

<script>
  const btnConfig = document.getElementById("btn-config");
  btnConfig?.addEventListener("click", () => showSettings());

  function showSettings() {
    
    // debugging
    console.log("Settings button clicked");
  }
</script>
