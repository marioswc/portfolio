---
import CardSection from "@components/ui/CardSection.astro";
import Button from "@components/ui/Button.astro";
import StackRender from "./renders/StackRender.astro";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations } from "@i18n/utils";
import Music from "../leftside/Music.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<CardSection pinned={true} year={2026}>
  <p>{t("overview.intro")}</p>
</CardSection>
<CardSection pinned={false} year={2026}>
  <div class="flex flex-col items-start gap-2">
    <h3 class="font-inter tracking-normal font-semibold text-text text-sm">
      {t("overview.services.title")}
    </h3>
    <p class="text-sm text-text leading-relaxed">
      {t("overview.services.description")}
    </p>
    <Button
      href="#"
      clazz="text-xs mt-1 items-center gap-1.5 px-4 py-2 border-transparent font-semibold rounded-full bg-bg-secondary text-sm text-text-secondary hover:bg-secondary-hover"
    >
      <span>{t("overview.services.cta")}</span>
      <Icon name="square-out" class="size-4" aria-hidden="true" />
    </Button>
  </div>
</CardSection>
<CardSection pinned={false} year={2024}>
  <p>
    {t("overview.music")}
  </p>
  <div class="block lg:hidden mt-2 border border-line shadow-xs rounded-lg p-4 max-w-lg w-full">
    <h2 class="text-xl font-extrabold text-text mb-1">{t("music.title")}</h2>
    <Music server:defer lang={lang}>
      <div slot="fallback" class="w-full">
        <div class="flex items-center justify-start gap-2 motion-safe:animate-pulse">
          <div class="size-16 shrink-0 rounded-lg bg-line/80 shadow-sm" />
          <div class="flex flex-col items-start gap-1.5 ml-2">
            <span class="h-5 w-28 rounded-md bg-line/80" />
            <span class="h-3.5 w-20 rounded-md bg-line/70" />
            <span class="h-3 w-14 rounded-md bg-line/60" />
          </div>
        </div>
      </div>
    </Music>
  </div>
</CardSection>
<CardSection pinned={false} year={2023}>
  <h3 class="font-inter tracking-normal">{t("overview.stack")}</h3>
  <StackRender />
</CardSection>
