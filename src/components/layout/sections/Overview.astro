---
import CardSection from "@components/ui/CardSection.astro";
import StackRender from "./renders/StackRender.astro";
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<CardSection pinned={true} year={2026}>
  <p>
    {t("overview.intro")}
  </p>
</CardSection>
<CardSection pinned={false} year={2024}>
  <p>
    {t("overview.music")}
  </p>
</CardSection>
<CardSection pinned={false} year={2023}>
  <p>{t("overview.stack")}</p>
  <StackRender />
</CardSection>
