---
import Stack from "@data/stack.json";
---

<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 mt-2">
  {
    Stack.map((item) => (
      <div class="flex items-start flex-col p-3 rounded-lg bg-bg shadow-xs border border-line">
        <p class="font-semibold text-text text-sm mb-2">{item.category}</p>
        <ul class="flex items-center gap-2 flex-wrap">
          {item.skills.map((skill) => (
            <li>
              <span class="text-muted text-xs border border-line p-1 rounded-lg hover:border-primary hover:text-primary transition-all duration-300 ease-linear">
                {skill}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
