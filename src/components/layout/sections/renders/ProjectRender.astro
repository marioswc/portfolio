---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Projects from "@data/projects.json";
import CardSection from "@components/ui/CardSection.astro";
import ButtonRepo from "@components/ui/ButtonRepo.astro";

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{webp,png,jpg,jpeg}",
  { eager: true },
);

const getProjectImage = (filename: string) =>
  projectImages[`/src/assets/images/projects/${filename}`]?.default;
---

{
  Projects.map((item) => {
    const projectImage = getProjectImage(item.image);
    return (
      <CardSection pinned={false} year={item.year} load="lazy">
        <p class="text-text text-sm">
          <strong class="font-semibold text-text">{item.title} </strong>—{" "}
          {item.summary}
        </p>
        <ul class="flex items-center list-none gap-1 flex-wrap">
          {item.tags.map((tag) => (
            <li>
              <span class="text-primary cursor-pointer underline-offset-2 hover:underline">
                #{tag}
              </span>
            </li>
          ))}
        </ul>
        {
          projectImage && (
            <figure class="mt-2 border border-line shadow-xs max-w-md aspect-video overflow-hidden rounded-lg">
              <Image
                src={projectImage}
                alt={`Preview of ${item.title}`}
                width={896}
                widths={[448, 896]}
                sizes="(max-width: 640px) 100vw, 448px"
                class="object-cover object-top w-full h-full"
                loading="lazy"
                decoding="async"
                draggable="false"
                fetchpriority="low"
              />
            </figure>
          )
        }
        <ButtonRepo
          id={item.id}
          title={item.title}
          img={projectImage}
          code_url={item.code_url}
          demo_url={item.demo_url}
          desc={item.description}
          features={item.features}
          stack={item.tags}
        />
      </CardSection>
    );
  })
}
