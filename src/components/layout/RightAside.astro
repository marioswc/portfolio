---
import CardAside from "../ui/CardAside.astro";
import GitHub from "./rightside/GitHub.astro";
import Social from "./rightside/Social.astro";
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<aside aria-label={t("aside.rightAria")} class="sticky top-0 p-2 hidden lg:flex flex-col gap-2 items-start w-full">
    <CardAside>
        <GitHub />
    </CardAside>
    <CardAside>
        <Social />
    </CardAside>
    <div class="w-full flex justify-center">
        <small class="text-xs">{t("aside.builtWith")}</small>
    </div>
</aside>