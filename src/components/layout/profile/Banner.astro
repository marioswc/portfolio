---
import Banner from "@assets/images/banner.jpeg";
import { Image } from "astro:assets";
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<figure class="w-full h-30 overflow-hidden border-b border-line">
  <Image
    src={Banner}
    alt={t("profile.bannerAlt")}
    widths={[480, 623, 768, 1090, 1246]}
    sizes="(max-width: 1023px) 100vw, (max-width: 1280px) calc(100vw - 689px), 623px"
    class="object-cover w-full h-full"
    width={623}
    height={156}
    draggable="false"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />
</figure>
