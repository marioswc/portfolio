---
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<div class="w-full mt-5 px-2">
    <div class="leading-4">
        <h2 class="font-bold text-2xl">Mario Mendoza</h2>
        <p class="text-muted text-sm">@marioswc</p>
    </div>
    <div class="mt-4">
        <p class="text-sm text-text ">
            {t("profile.bio")}
        </p>
    </div>
    <div class="mt-4 w-full flex flex-wrap items-center justify-start text-muted gap-x-4 gap-y-2">
        <div class="flex items-center gap-1.5">
            <Icon name="location" class="size-4" aria-hidden="true" />
            <span class="text-sm">{t("profile.location")}</span>
        </div>
        <div class="flex items-center gap-1.5">
            <Icon name="world" class="size-3.5" aria-hidden="true" />
            <span class="text-sm">{t("profile.languages")}</span>
        </div>
        <div class="flex items-center gap-1.5 px-1">
            <div class="flex relative size-2" aria-hidden="true">
                <span class="size-full bg-bg-status rounded-full"></span>
                <span class="absolute size-full bg-bg-status-2 opacity-75 rounded-full motion-safe:animate-ping"></span>
            </div>
            <span class="text-sm">{t("profile.status")}</span>
        </div>
    </div>
</div>