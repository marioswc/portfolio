---
import Banner from "./Banner.astro";
import ProfilePicture from "./ProfilePicture.astro";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import ProfileInfo from "./Info.astro";
import ViewResume from "./ViewResume.astro";
---

<Banner />
<div class="relative">
  <ProfilePicture
    load={"eager"}
    sizes="(max-width: 640px) 112px, 128px"
    clazz="absolute w-28 sm:w-32 left-4 sm:left-5 -top-14 sm:-top-18 border-2"/>
  <div class="w-full px-2 flex items-center justify-end gap-2 mt-2">
    <Button
      href="https://www.linkedin.com/in/marioswc/"
      ariaLabel="Contact on LinkedIn"
      clazz="border border-line p-2 rounded-full bg-bg text-text hover:bg-primary-hover"
    >
      <Icon name="chat" class="size-5" />
    </Button>
    <ViewResume />
  </div>
</div>
<ProfileInfo />
