---
import { getLang, useTranslations } from "@i18n/utils";

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const lang = getLang(propLang ?? Astro.currentLocale);
const t = useTranslations(lang);

// cache control for Cloudflare
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=600"
);

const userUrl = "https://api.github.com/users/marioswc";
const reposUrl =
  "https://api.github.com/users/marioswc/repos?sort=pushed&per_page=1";

const ghHeaders: HeadersInit = {
  Accept: "application/vnd.github.v3+json",
  "User-Agent": "mariosdev-portfolio",
};

type GitHubStats = {
  lastPush: string;
  lastPushUrl: string;
  totalRepos: number;
  followers: number;
  lastLanguage: string;
};

const CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutos

// Global cache to store GitHub stats and their expiration time
const globalCache = globalThis as unknown as {
  __ghStatsCache?: { data: GitHubStats; expiresAt: number };
};

const FALLBACK_STATS: GitHubStats = {
  lastPush: "portfolio",
  lastPushUrl: "https://github.com/marioswc/portfolio",
  totalRepos: 10,
  followers: 10,
  lastLanguage: "Astro",
};

async function getGitHubInfo(): Promise<GitHubStats> {
  const now = Date.now();
  const cached = globalCache.__ghStatsCache;

  // if cached data exists and is still valid, return it
  if (cached && now < cached.expiresAt) {
    return cached.data;
  }

  try {
    // options for fetch, including cache settings for Cloudflare
    const fetchOptions: RequestInit & { cf?: Record<string, unknown> } = {
      headers: ghHeaders,
      cf: {
        cacheTtl: 300,
        cacheEverything: true,
      },
    };

    const [userRes, reposRes] = await Promise.all([
      fetch(userUrl, fetchOptions),
      fetch(reposUrl, fetchOptions),
    ]);

    if (!userRes.ok || !reposRes.ok) {
      throw new Error(`Failed to fetch GitHub info (${userRes.status} / ${reposRes.status})`);
    }

    const user = await userRes.json();
    const repos = await reposRes.json();
    const latestRepo = repos[0];

    const freshData: GitHubStats = {
      lastPush: latestRepo?.name ?? FALLBACK_STATS.lastPush,
      lastPushUrl: latestRepo?.html_url ?? FALLBACK_STATS.lastPushUrl,
      totalRepos: user.public_repos ?? FALLBACK_STATS.totalRepos,
      followers: user.followers ?? FALLBACK_STATS.followers,
      lastLanguage: latestRepo?.language ?? FALLBACK_STATS.lastLanguage,
    };

    // Store in cache
    globalCache.__ghStatsCache = {
      data: freshData,
      expiresAt: now + CACHE_TTL_MS,
    };

    return freshData;
  } catch (error) {
    console.error(error);
    // if fetching fails, return cached data if available, otherwise fallback
    return cached?.data ?? FALLBACK_STATS;
  }
}

const githubInfo = await getGitHubInfo();
const dataGit = [
  { label: t("github.lastPush"), value: githubInfo.lastPush, href: githubInfo.lastPushUrl },
  { label: t("github.totalRepos"), value: githubInfo.totalRepos },
  { label: t("github.followers"), value: githubInfo.followers },
  { label: t("github.topLanguage"), value: githubInfo.lastLanguage },
];
---

<h2 class="text-xl font-extrabold text-text mb-1">{t("github.title")}</h2>
<div class="flex flex-col gap-4 items-start">
  {dataGit.map((data) => (
    <div class="flex flex-col items-start">
      <span class="text-muted text-sm leading-4">{data.label}</span>
      {data.href ? (
        <a
          href={data.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text text-lg font-extrabold font-geist tracking-tight hover:text-primary hover:underline underline-offset-2 transition-colors duration-200"
        >
          {data.value}
        </a>
      ) : (
        <span class="text-text text-lg font-extrabold font-geist tracking-tight">
          {data.value}
        </span>
      )}
    </div>
  ))}
</div>

