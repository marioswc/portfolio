---
import { useTranslations } from "@i18n/utils";

const t = useTranslations(Astro.currentLocale);

const dataGit = [
  {
    label: t("github.lastPush"),
    value: "portfolio",
  },
  {
    label: t("github.totalRepos"),
    value: "10",
  },
  {
    label: t("github.followers"),
    value: "10",
  },
  {
    label: t("github.topLanguage"),
    value: "JavaScript",
  },
];
---

<h2 class="text-xl font-extrabold text-text mb-1">{t("github.title")}</h2>
<div class="flex flex-col gap-4 items-start">
    {
        dataGit.map((data) => (
            <div class="flex flex-col items-start">
                <span class="text-muted text-sm leading-4">{data.label}</span>
                <span class="text-text text-lg font-extrabold font-geist tracking-tight">{data.value}</span>
            </div>
        ))
    }
</div>