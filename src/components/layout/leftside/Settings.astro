---
import Modal from "@components/ui/Modal.astro";
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "desktop" | "mobile";
}

const { variant = "desktop" } = Astro.props;
const isMobile = variant === "mobile";
---

<Modal
  id={isMobile ? "mobile-settings" : "settings"}
  title="Appearance"
  dialClass="max-w-md"
  ariaLabel={isMobile ? "Open settings" : undefined}
  btnClass={
    isMobile
      ? "lg:hidden block p-2 rounded-full bg-bg-secondary text-text-secondary hover:bg-secondary-hover"
      : "w-full flex items-center justify-center text-sm gap-2 font-semibold p-2 rounded-full bg-bg-secondary text-text-secondary hover:bg-secondary-hover"
  }
>
  <Fragment slot="content">
    <div class="p-4">
      <div class="flex flex-col gap-2 items-start text-text">
        <span class="text-sm font-semibold">Language</span>
        <div class="flex items-center text-text">
          <button
            type="button"
            class="text-muted px-4 py-2 rounded-l-full cursor-pointer border-r-0 border border-line"
          >
            Spanish
          </button>
          <button
            type="button"
            class="px-4 py-2 rounded-r-full cursor-pointer bg-bg-secondary text-text-secondary"
          >
            English
          </button>
        </div>
        <span class="text-sm font-semibold">Theme</span>
        <div class="flex items-center text-text">
          <button
            type="button"
            data-theme-btn="light"
            aria-selected="true"
            class="text-muted px-4 py-2 border border-line rounded-l-full cursor-pointer hover:bg-primary-hover hover:text-text transition-colors duration-300 ease-linear aria-selected:bg-bg-secondary aria-selected:text-text-secondary aria-selected:border-bg-secondary"
          >
            Light
          </button>
          <button
            type="button"
            data-theme-btn="dark"
            aria-selected="false"
            class="text-muted px-4 py-2 border-l-0 border border-line rounded-r-full cursor-pointer hover:bg-primary-hover hover:text-text transition-colors duration-300 ease-linear aria-selected:bg-bg-secondary aria-selected:text-text-secondary aria-selected:border-bg-secondary"
          >
            Dark
          </button>
        </div>
      </div>
    </div>
  </Fragment>

  <Fragment slot="btnShowModal">
    <Icon name="settings" class={isMobile ? "size-5" : "size-4"} />
    {!isMobile && <span>Open Settings</span>}
  </Fragment>
</Modal>

<script>
  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-btn]");

  const syncThemeButtons = (theme: "light" | "dark") => {
    themeButtons.forEach((btn) => {
      const isSelected = btn.dataset.themeBtn === theme;
      btn.setAttribute("aria-selected", String(isSelected));
    });
  };

  const currentTheme = document.documentElement.classList.contains("dark")
    ? "dark"
    : "light";
  syncThemeButtons(currentTheme);

  themeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selectedTheme = btn.dataset.themeBtn === "dark" ? "dark" : "light";
      document.documentElement.classList.toggle("dark", selectedTheme === "dark");
      localStorage.setItem("theme", selectedTheme);
      syncThemeButtons(selectedTheme);
    });
  });
</script>
