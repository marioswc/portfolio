---
import { Icon } from "astro-icon/components";
---

<div class="w-full mt-5 px-2">
    <div class="leading-4">
        <h2 class="font-bold text-2xl">Mario Mendoza</h2>
        <p class="text-muted text-sm">@marioswc</p>
    </div>
    <div class="mt-4">
        <p class="text-sm text-text ">
            Software Developer | Tech Enthusiast
        </p>
    </div>
    <div class="mt-4 w-full flex flex-wrap items-center justify-start text-muted gap-x-4 gap-y-2">
        <span class="flex items-center gap-1.5">
            <Icon name="location" class="size-4" />
            <p class="text-sm">Mexico City</p>
        </span>
        <span class="flex items-center gap-1.5">
            <Icon name="world" class="size-3.5" />
            <p class="text-sm">ES | EN (B1)</p>
        </span>
        <span class="flex items-center gap-1.5 px-1">
            <span class="flex relative size-2">
                <span class="size-full bg-emerald-400 rounded-full"></span>
                <span class="absolute size-full bg-emerald-700 opacity-75 rounded-full animate-ping"></span>
            </span>
            <p class="text-sm">Open to hire</p>
        </span>
    </div>
</div>