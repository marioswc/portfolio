---
import { Icon } from "astro-icon/components";
interface Props {
  year?: number;
}
const { year } = Astro.props as Props;
---

<div class="flex items-center gap-2">
  <div class="flex items-center gap-1 text-text text-sm">
    <strong class="font-bold font-geist tracking-tight">Mario Mendoza</strong>
    <Icon name="verified" class="size-4" aria-hidden="true" />
  </div>
  <div class="flex items-center gap-1 text-muted text-sm">
    <span>@marioswc</span>
    <span>·</span>
    <time>{year ?? "2026"}</time>
  </div>
</div>
