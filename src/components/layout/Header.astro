---
import { Icon } from "astro-icon/components";
---

<header class="py-1 px-2 sticky top-0 z-50 backdrop-blur-2xl shadow-xl bg-bg-header">
  <div class="flex items-center justify-between px-2">
    <!-- desktop -->
    <div class="flex flex-col items-start justify-between">
      <h1 class="text-xl flex flex-col leading-none">
        <div class="font-bold text-text flex items-center gap-1">
          <span>Mario Mendoza</span>
          <Icon name="verified" class="size-5" />
        </div>
        <small class="text-muted text-sm">Software Developer</small>
      </h1>
    </div>
    <!-- mobile menu -->
    <button
      class="lg:hidden block text-text focus:outline-none bg-transparent cursor-pointer"
      aria-label="Toggle Menu">
      <Icon name="settings" class="size-7 text-text" />
    </button>
  </div>
</header>
