---
import Layout from "../layouts/Layout.astro";
import ProfilePicture from "@components/layout/profile/ProfilePicture.astro";
import { Icon } from "astro-icon/components";
import { ui } from "@i18n/ui";

const en = ui.en;
const esStrings = {
  "404.title": ui.es["404.title"],
  "404.description": ui.es["404.description"],
  "404.backHome": ui.es["404.backHome"],
};
---

<Layout>
  <main
    class="min-h-dvh flex flex-col items-center justify-center px-6 py-12 text-center"
    data-404-root
    data-es={JSON.stringify(esStrings)}
  >
    <div class="flex flex-col items-center max-w-md w-full">
      <!-- Identidad -->
      <ProfilePicture load="eager" alt="" clazz="w-20 border-2" sizes="80px" />
      <p class="mt-2.5 text-sm font-medium text-muted">@marioswc</p>

      <!-- Badge Error 404 -->
      <span
        class="mt-6 inline-flex items-center px-3 py-0.5 rounded-full border border-line bg-tile text-xs font-geist font-semibold tracking-wider uppercase text-muted"
      >
        Error 404
      </span>

      <!-- Título y descripción -->
      <h1
        class="mt-3 text-3xl sm:text-4xl font-extrabold font-geist tracking-tight text-text"
        data-i18n="404.title"
      >
        {en["404.title"]}
      </h1>
      <p
        class="mt-2.5 max-w-sm text-sm leading-relaxed text-muted"
        data-i18n="404.description"
      >
        {en["404.description"]}
      </p>

      <!-- CTA -->
      <a
        href="/"
        data-404-home
        class="mt-7 inline-flex items-center gap-1.5 px-5 py-2.5 text-sm text-text-secondary font-semibold bg-bg-secondary rounded-full hover:bg-secondary-hover transition-colors duration-300 ease-linear"
      >
        <Icon name="arrow-left" class="size-4" aria-hidden="true" />
        <span data-i18n="404.backHome">{en["404.backHome"]}</span>
      </a>
    </div>
  </main>

  <script is:inline>
    (() => {
      const path = window.location.pathname;
      const isEsPath = path === "/es" || path.startsWith("/es/");
      const prefersEs =
        isEsPath || navigator.language?.toLowerCase().startsWith("es");
      if (!prefersEs) return;

      const root = document.querySelector("[data-404-root]");
      if (!root) return;
      const es = JSON.parse(root.getAttribute("data-es") || "{}");

      root.querySelectorAll("[data-i18n]").forEach((el) => {
        const value = es[el.getAttribute("data-i18n")];
        if (value) el.textContent = value;
      });
      root
        .querySelectorAll("[data-404-home]")
        .forEach((el) => el.setAttribute("href", "/es/"));

      document.documentElement.lang = "es";
    })();
  </script>
</Layout>
